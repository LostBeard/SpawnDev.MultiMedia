<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2.6.0</Version>
		<PackageReleaseNotes>v2.6.0 - H.264 rate control: constant QP and quality besides constant bitrate (H264EncoderOptions); YUV to RGB conversions now BT.601 limited range (they decoded video-range YUV as full range: washed-out colours); BGRA / RGB24 / I420 to NV12. SpawnDev.SpawnJS 3.0.10, SpawnDev.ILGPU 5.4.36. v2.5.0 - H.264 decoding: IVideoDecoder + the Media Foundation H.264 decoder (NV12 out) on desktop. SpawnDev.SpawnJS 3.0.7, SpawnDev.ILGPU 5.4.15. v2.4.0 - SpawnDev.SpawnJS 3.0.0 + SpawnDev.ILGPU 5.3.0. The browser test app runs on SpawnJS (SpawnDev.UnitTesting.Browser) instead of SpawnDev.BlazorJS.</PackageReleaseNotes>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EmbedAllSources>true</EmbedAllSources>
		<DebugType>Embedded</DebugType>
		<Title>SpawnDev.MultiMedia</Title>
		<Authors>LostBeard</Authors>
		<Description>.Net cross platform media capture and playback for browser and desktop.</Description>
		<PackageProjectUrl>https://github.com/LostBeard/SpawnDev.MultiMedia</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<PackageIcon>icon-128.png</PackageIcon>
		<RepositoryUrl>https://github.com/LostBeard/SpawnDev.MultiMedia.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Blazor;BlazorWebAssembly;Media;Camera;Microphone;Audio;Video;CrossPlatform</PackageTags>
		<NoPackageAnalysis>true</NoPackageAnalysis>
		<EnableDefaultCompileItems>true</EnableDefaultCompileItems>
		<IsPackable>true</IsPackable>
		<LangVersion>latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NoWarn>$(NoWarn);CS1591</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.2" />
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.10" />
		<PackageReference Include="SpawnDev.ILGPU" Version="5.4.36" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Assets\icon-128.png" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE.txt" Pack="true" PackagePath="\" />
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="wwwroot\icon-128.png" />
	</ItemGroup>

	<ItemGroup>
		<Content Remove="wwwroot\icon-128.png" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
		<SupportedPlatform Include="windows" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Browser\" />
		<Folder Include="Windows\" />
	</ItemGroup>

</Project>
